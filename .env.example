# 馬祖藍眼淚預報 — 後端環境變數範例
# 複製為 .env.local（vercel dev 會自動讀取）或在 Vercel 專案設定中新增。
# 沒有任何金鑰時 API 仍可運作，回傳 mode: "model"（天文計算＋氣候平均）。

# 中央氣象署「氣象資料開放平臺」授權碼 https://opendata.cwa.gov.tw/user/authkey
CWA_API_KEY=

# 交通部 TDX 運輸資料流通服務 API 金鑰 https://tdx.transportdata.tw/user/dataservice/key
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# 上游快取秒數（記憶體 + CDN s-maxage），預設 600 = 10 分鐘
CACHE_TTL_SEC=600
